generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  avatar      String?
  roleIds     String[] // rolurile Discord ale userului
  points      Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions      WorkSession[]
  leaveRequests LeaveRequest[]
  resignations  Resignation[]
  pointsGiven   PointHistory[] @relation("ModeratorPoints")
  pointsReceived PointHistory[] @relation("UserPoints")

  approvedLeaves    LeaveRequest[] @relation("ApprovedLeaves")
  approvedResigns   Resignation[]  @relation("ApprovedResigns")
  taxPayments  TaxPayment[]
  shopOrders  ShopOrder[]
  wheelSpins  WheelSpin[]
  taskClaims  TaskClaim[]
  notifications Notification[]
  fines  Fine[]
  bugReports  BugReport[]
  banned     Boolean  @default(false)
  bannedAt   DateTime?
  bannedBy   String?
  banReason  String?
  joinedAt   DateTime?
}

model WorkSession {
  id           String    @id @default(cuid())
  userId       String
  clockIn      DateTime
  clockOut     DateTime?
  totalMinutes Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String?
  username   String?
  reason     String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())

  user     User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  approver User? @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
}

model Resignation {
  id         String            @id @default(cuid())
  userId     String?
  username   String?
  reason     String
  status     ResignationStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime          @default(now())

  user     User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  approver User? @relation("ApprovedResigns", fields: [approvedBy], references: [id])
}

model PointHistory {
  id          String   @id @default(cuid())
  userId      String
  moderatorId String
  amount      Float
  reason      String
  createdAt   DateTime @default(now())

  user      User @relation("UserPoints",     fields: [userId],      references: [id], onDelete: Cascade)
  moderator User @relation("ModeratorPoints",fields: [moderatorId], references: [id], onDelete: Cascade)
}

enum LeaveStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ResignationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Whitelist {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String?
  addedBy   String
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  important Boolean  @default(false)
  author    String
  authorId  String
  createdAt DateTime @default(now())
}

model TaxItem {
  id          String    @id @default(cuid())
  name        String
  bucati      Int       @default(0)
  jafuri      Json?
  termen      DateTime?
  targetRoles String[]  @default([])
  weekStart   DateTime
  createdBy   String
  createdAt   DateTime  @default(now())
}

model TaxPayment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String    @default("all")
  weekStart DateTime
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, weekStart])
}

model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Int
  stock       Int      @default(-1)
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requirementType String?
  orders ShopOrder[]
}

model ShopOrder {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model WheelPrize {
  id        String   @id @default(cuid())
  label     String
  type      String   @default("points")
  value     Int      @default(0)
  itemId    String?
  chance    Int      @default(10)
  color     String   @default("#00ff66")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WheelSpin {
  id         String   @id @default(cuid())
  userId     String
  prizeId    String
  prizeLabel String
  cost       Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WheelConfig {
  id        String   @id @default(cuid())
  spinCost  Int      @default(10)
  updatedAt DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  points      Int
  stock       Int      @default(-1)
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())

  claims TaskClaim[]
}

model TaskClaim {
  id         String      @id @default(cuid())
  taskId     String
  userId     String
  status     ClaimStatus @default(PENDING)
  claimedAt  DateTime    @default(now())
  reviewedBy String?
  reviewedAt DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Fine {
  id          String   @id @default(cuid())
  userId      String
  tip         String   @default("amenda") // "amenda" sau "fw"
  motiv       String   @default("")
  material    String
  bucati      Int      @default(0)
  termen      String   @default("")
  fwLevel     Int?
  givenBy     String
  givenByName String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BugReport {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String
  mediaUrls   String[]  @default([])
  status      BugStatus @default(OPEN)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model BotLog {
  id        String   @id @default(cuid())
  categorie String   // "muncitori" | "taxa" | "jafuri"
  titlu     String
  continut  String
  createdAt DateTime @default(now())
}

model SiteConfig {
  id          String  @id @default("main")
  maintenance Boolean @default(false)
  taxPaused   Boolean @default(false)
  message     String  @default("Site-ul este în mentenanță. Revenim în curând!")
}
